{
  "name": "funiltrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "tsx server/src/server.ts",
    "build": "pnpm typecheck && vite build && pnpm build:backend",
    "build:backend": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "start": "node server/dist/server.js",
    "db:migrate": "tsx server/src/migrate.ts",
    "db:seed": "tsx server/src/seed.ts",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed": "node scripts/generate-mock-data.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-virtual": "^3.14.9",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@tailwindcss/vite": "^4.1.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/node": "^22.15.32",
    "@types/pg": "^8.15.4",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.0",
    "tsx": "^4.19.4",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "caniuse-lite": "1.0.30001806",
      "node-releases": "2.0.52",
      "postcss": "8.5.25",
      "tsx": "4.23.6"
    }
  }
}
