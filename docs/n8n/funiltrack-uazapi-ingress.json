      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [720, -80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, accepted: true }) }}",
        "options": { "responseCode": 200 }
      },
      "id": "f4a1b5c9-2d12-4e86-a0c5-0b2a9d5e1e05",
      "name": "Responder OK",
