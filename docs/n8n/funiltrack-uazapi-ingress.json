    {
      "parameters": {
        "jsCode": "const input = $input.all()[0]?.json ?? {};\nconst body = input.body && typeof input.body === 'object' ? input.body : input;\nconst query = input.query && typeof input.query === 'object' ? input.query : {};\nconst secret = typeof query.secret === 'string' ? query.secret : '';\nif (!secret) {\n  return [{ json: { valid: false, reason: 'missing_webhook_secret' } }];\n}\nreturn [{ json: { valid: true, secret, payload: body } }];"
      },
      "id": "f4a1b5c9-2d12-4e86-a0c5-0b2a9d5e1e02",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            { "id": "valid-input", "leftValue": "={{ $json.valid }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f4a1b5c9-2d12-4e86-a0c5-0b2a9d5e1e03",
      "name": "Entrada autorizada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://j30xzsgt5bgou5a4rup6uvh8.147.93.139.212.sslip.io/api/whatsapp/uazapi-webhook?secret=' + encodeURIComponent($json.secret) }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "content-type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": { "timeout": 30000 }
      },
      "id": "f4a1b5c9-2d12-4e86-a0c5-0b2a9d5e1e04",
      "name": "Entregar ao FunilTrack",
      "type": "n8n-nodes-base.httpRequest",
