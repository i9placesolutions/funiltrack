# FunilTrack — variáveis de ambiente (exemplo)
# Copie para .env.local e ajuste conforme necessário.

# 'false' usa o backend real (padrão); 'true' mantém o modo de demonstração.
VITE_USE_MOCKS=false

# Em desenvolvimento o Vite encaminha /api para o backend na porta 3333.
VITE_API_BASE_URL=/api
VITE_API_TOKEN=

# Backend
PORT=3333
HOST=0.0.0.0
DATABASE_URL=postgresql://funiltrack:funiltrack@127.0.0.1:5432/funiltrack
DATABASE_SSL=false
PG_POOL_MAX=10
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=false
SEED_DEMO_DATA=false
CORS_ORIGIN=http://localhost:5173

# Protege integrações de entrada (n8n/WhatsApp/Meta). Gere valores reais
# somente no ambiente local/produção; nunca os versione.
API_TOKEN=
WEBHOOK_TOKEN=

# Autenticação da aplicação. Não versione valores reais.
AUTH_ALLOW_REGISTRATION=true
AUTH_SESSION_TTL_DAYS=14
AUTH_SECURE_COOKIE=false

# URL pública usada para registrar o webhook da UazAPI.
APP_PUBLIC_URL=http://localhost:3333
# Opcional: se preenchido, a UazAPI entrega primeiro ao webhook do n8n.
N8N_UAZAPI_WEBHOOK_URL=

# UazAPI — o token regular é usado no backend; nunca o exponha no Vite.
UAZAPI_BASE_URL=https://api.uazapi.com
UAZAPI_TOKEN=
UAZAPI_ADMIN_TOKEN=
UAZAPI_INSTANCE_NAME=funiltrack
# Obrigatória somente se uma instância for criada pela API e armazenada no banco.
UAZAPI_ENCRYPTION_KEY=
UAZAPI_WEBHOOK_SECRET=

# Meta Ads / Conversions API — tokens ficam somente no backend/Coolify.
# Crie o app no Meta Developers, gere um token com acesso à conta de anúncios
# e informe o ID da conta (com ou sem o prefixo act_).
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
# Dataset/Pixel usado para receber Lead, QualifiedLead e Purchase.
META_DATASET_ID=
META_PIXEL_ID=
META_CURRENCY=BRL
# Opcional, somente para testes no Events Manager.
META_TEST_EVENT_CODE=
