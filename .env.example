# FunilTrack — variáveis de ambiente (exemplo)
# Copie para .env.local e ajuste conforme necessário.

# 'false' usa o backend real (padrão); 'true' mantém o modo de demonstração.
VITE_USE_MOCKS=false

# Em desenvolvimento o Vite encaminha /api para o backend na porta 3333.
VITE_API_BASE_URL=/api
VITE_API_TOKEN=

# Backend
PORT=3333
HOST=0.0.0.0
DATABASE_URL=postgresql://funiltrack:funiltrack@127.0.0.1:5432/funiltrack
DATABASE_SSL=false
PG_POOL_MAX=10
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=false
SEED_DEMO_DATA=true
CORS_ORIGIN=http://localhost:5173

# Protege integrações de entrada (n8n/WhatsApp/Meta). Gere valores reais
# somente no ambiente local/produção; nunca os versione.
API_TOKEN=
WEBHOOK_TOKEN=
